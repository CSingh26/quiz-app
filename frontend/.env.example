# Trailing slash is required by the existing route helpers. Embedded at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3876/api/
# QuizBee 2.0 uses a separate PostgreSQL database; never point this at legacy MongoDB.
PLATFORM_DATABASE_URL=postgresql://quizbee:quizbee_local_only@127.0.0.1:55439/quizbee_v2?schema=public
APP_ORIGIN=http://localhost:3018
# Local-only HTTP testing of a production build. Never enable for a public host.
ALLOW_LOCAL_HTTP=true
# Files are private and never served as public static assets.
PRIVATE_STORAGE_DIR=.quizbee-private
# Development worker only: explicit local bypass if no malware scanner is installed.
ALLOW_UNSCANNED_UPLOADS=true
# Set an absolute executable path for a clamscan-compatible scanner.
# MALWARE_SCAN_COMMAND=/usr/local/bin/clamscan
# Optional OpenAI-compatible provider. No generation occurs without these values.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional local Mailpit SMTP for actual verification/reset delivery.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=QuizBee <noreply@quizbee.local>
