# Legacy browser API helpers require a trailing slash; this public URL is embedded at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3876/api/
# Runtime-only origin of the independently deployed QuizBee platform API.
# Do not include /api/v2, credentials, query parameters, or a trailing path.
PLATFORM_API_URL=http://127.0.0.1:4010
# Optional bounded upstream deadline (1–60000 milliseconds; default 30000).
# PLATFORM_API_TIMEOUT_MS=30000
# Database, mail, storage, and AI provider configuration belongs only in services/platform.
