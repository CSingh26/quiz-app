# Standalone API and worker settings. Never copy these into the web environment.
PLATFORM_DATABASE_URL=postgresql://quizbee:quizbee_local_only@127.0.0.1:55439/quizbee_v2?schema=public&connection_limit=10
APP_ORIGIN=http://localhost:3018
API_HOST=127.0.0.1
PORT=4010
ALLOW_LOCAL_HTTP=true
# This bypass is accepted only outside NODE_ENV=production.
ALLOW_UNSCANNED_UPLOADS=true
MALWARE_SCAN_COMMAND=
UPLOADS_ENABLED=true
GENERATION_ENABLED=false
# Use local only when API and workers share this private directory.
STORAGE_DRIVER=local
PRIVATE_STORAGE_DIR=.quizbee-private
# For separate hosts use s3 and provision a private, unversioned bucket.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_PREFIX=quizbee/
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REQUEST_TIMEOUT_MS=15000
WORKER_KINDS=ingestion,generation
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8081
# Optional OpenAI-compatible provider. Generation runs only in the worker.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=QuizBee <noreply@quizbee.local>
TRUST_PROXY=false
