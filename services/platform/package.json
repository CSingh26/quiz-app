{
  "name": "@quizbee/platform",
  "version": "2.0.0-rc.1",
  "private": true,
  "description": "QuizBee standalone API and distributed background workers",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/api/run.ts",
    "start": "tsx --env-file-if-exists=.env src/api/run.ts",
    "worker": "tsx --env-file-if-exists=.env src/server/jobs/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:storage": "tsx --test tests/storage/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1128.0",
    "@prisma/client": "6.19.3",
    "fast-xml-parser": "5.11.2",
    "nodemailer": "10.0.13",
    "pdfjs-dist": "6.3.289",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "yauzl": "3.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/yauzl": "3.4.0",
    "prettier": "3.9.9",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
