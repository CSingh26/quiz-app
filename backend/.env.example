# MongoDB replica set required for Prisma nested writes and transactions.
DATABASE_URL=mongodb://127.0.0.1:27028/quizbee_local?replicaSet=rs0&directConnection=true
PORT=3876
NODE_ENV=development
JWT_KEY=replace-with-a-long-random-local-secret
ADMIN_USERNAME=local-instructor
# Generate a bcrypt hash locally; never use a plaintext password here.
ADMIN_PWD=replace-with-bcrypt-hash
# Optional profile image uploads; configure only when exercising S3.
AWS_BUCKET_NAME=your-bucket
AWS_REGION_NAME=your-region
AWS_ACCESS_KEY=replace-locally
AWS_SECRET_ACCESS_KEY=replace-locally
DEFAULT_AVATAR_URL=https://example.invalid/avatar.png
DEFAULT_BACKGROUND_URL=https://example.invalid/background.png
