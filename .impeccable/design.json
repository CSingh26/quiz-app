      "description": "Visible label, quiet surface, and clear keyboard focus.",
      "html": "<label class=\"ds-field\"><span>Quiz title</span><input class=\"ds-input\" placeholder=\"A topic worth revisiting\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:7px;font:650 12px/1.5 QuizBeeSans,Arial,sans-serif;color:var(--qb-ink,#242820)}.ds-input{min-height:44px;padding:11px 12px;border:1px solid var(--qb-line,#d9dace);border-radius:7px;background:var(--qb-surface,#fffefb);color:var(--qb-ink,#242820);font:400 13px/1.6 QuizBeeSans,Arial,sans-serif;caret-color:var(--qb-green,#42553c)}.ds-input::placeholder{color:var(--qb-muted,#62675b)}.ds-input:hover{border-color:var(--qb-muted,#62675b)}.ds-input:focus-visible{outline:2px solid var(--qb-focus,#7c5c17);outline-offset:4px}"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "Text-and-icon index with a honey current location.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Study navigation\"><a href=\"#overview\" aria-current=\"page\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z\"/><path d=\"M9 21v-9h6v9\"/></svg>Overview</a><a href=\"#quizzes\">My quizzes</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:5px;background:var(--qb-sidebar,#efede5);padding:15px}.ds-nav a{display:flex;align-items:center;gap:12px;min-height:46px;padding:11px 14px;border-radius:7px;font:550 11px/1.65 QuizBeeSans,Arial,sans-serif;color:var(--qb-muted,#62675b);text-decoration:none}.ds-nav a:hover{background:var(--qb-soft,#edeae1);color:var(--qb-ink,#242820)}.ds-nav a[aria-current=page]{background:var(--qb-honey-soft,#f6eac9);color:var(--qb-ink,#242820);font-weight:680}.ds-nav a:focus-visible{outline:2px solid var(--qb-focus,#7c5c17);outline-offset:4px}"
    },
    {
      "name": "Status tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Compact descriptive state, with green success variant.",
      "html": "<span class=\"ds-tag\">Practice</span> <span class=\"ds-tag ds-tag-success\">Ready</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;min-height:25px;padding:3px 9px;border-radius:5px;font:600 10px/1.5 QuizBeeSans,Arial,sans-serif;color:var(--qb-muted,#62675b);background:var(--qb-soft,#edeae1)}.ds-tag-success{color:var(--qb-green,#42553c);background:var(--qb-green-soft,#e5eadf)}"
    },
    {
      "name": "Question sheet",
      "kind": "card",
      "refersTo": "question-surface",
      "description": "A focused reading surface, outlined rather than elevated.",
      "html": "<article class=\"ds-question\"><div class=\"ds-meta\">Question 1 of 3 \u00b7 1 point</div><h2>What would you like to understand?</h2><p>Give the question room to be read.</p></article>",
      "css": ".ds-question{background:var(--qb-surface,#fffefb);color:var(--qb-ink,#242820);border:1px solid var(--qb-line,#d9dace);border-radius:12px;padding:30px}.ds-meta{font:400 11px/1.65 QuizBeeSans,Arial,sans-serif;color:var(--qb-muted,#62675b)}.ds-question h2{font:400 30px/1.45 QuizBeeSerif,Georgia,serif;letter-spacing:-.015em;margin:26px 0 25px}.ds-question p{font:400 13px/1.65 QuizBeeSans,Arial,sans-serif;color:var(--qb-muted,#62675b)}"
    },
    {
      "name": "Selected answer",
      "kind": "custom",
      "description": "A native radio inside a visibly selected answer row.",
      "html": "<label class=\"ds-answer\"><input type=\"radio\" checked name=\"example-answer\"/><span class=\"ds-letter\">B</span><span>Recall it in your own words</span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg></label>",
      "css": ".ds-answer{position:relative;display:flex;align-items:center;gap:14px;padding:17px 18px;border:1px solid var(--qb-green,#42553c);border-radius:8px;min-height:61px;background:var(--qb-green-soft,#e5eadf);color:var(--qb-green,#42553c);font:400 13px/1.65 QuizBeeSans,Arial,sans-serif;cursor:pointer}.ds-answer input{position:absolute;opacity:0}.ds-answer:has(input:focus-visible){outline:2px solid var(--qb-focus,#7c5c17);outline-offset:3px}.ds-letter{display:grid;place-items:center;width:27px;height:27px;border:1px solid var(--qb-line,#d9dace);border-radius:5px;font-size:11px;flex-shrink:0}.ds-answer>svg{margin-left:auto}.ds-answer:hover{filter:brightness(.98)}"
    }
  ],
  "narrative": {
    "northStar": "The Academic Field Guide",
    "overview": "QuizBee treats studying as a thoughtful, ongoing practice. Warm paper, dark ink, honey actions, and muted green annotations establish an academic workspace that is welcoming without becoming childish. Generous serif headings introduce dense, useful lists and quiet controls.\n\nThe implemented world uses index-like navigation, compact version records, source passages, and a single-question study surface. The landing page is more expressive; task screens put readable questions and reliable state ahead of decoration. Light, dark, and system themes share the same hierarchy.",
    "keyCharacteristics": [
      "Warm paper and ink with restrained honey actions.",
      "Local serif headlines paired with a clear sans-serif interface.",
      "Useful rows and visible revision records instead of a uniform card grid.",
      "Quiet task surfaces with explicit loading, saved, empty, error, and pending-review states.",
      "A small geometric hexagon-and-bee mark, not a character illustration."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Honey identifies a next action or current location. It does not imply a score, an award, or activity that the application has not measured.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Serif type introduces ideas and questions; sans-serif type explains actions, state, and records. Do not introduce a third display face.",
        "section": "typography"
      },
      {
        "name": "The Reading Space Rule",
        "body": "Collapse secondary columns before shrinking the question, field, or source text into the remaining space.",
        "section": "layout"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use a border or a tonal surface for ordinary working content. Preserve elevated treatment for the few surfaces that visibly overlap another surface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the academic field-guide character: warm paper, ink, compact records, and generous serif headings.",
      "**Do** use the shared semantic colors so light and dark themes preserve the same hierarchy.",
      "**Do** use rows for comparable records and a dedicated sheet for a focused question or form.",
      "**Do** show real loading, error, empty, saved, and pending-review states in the same visual system.",
      "**Do** retain native controls, descriptive labels, visible focus, and an accessible alternative to dragging.",
      "**Do** label illustrative landing content as an example and derive progress from actual records."
    ],
    "donts": [
      "**Don't** add blue/pink legacy styling to new study routes or silently restyle legacy routes through global selectors.",
      "**Don't** replace useful collections with a uniform grid of decorative cards.",
      "**Don't** use exaggerated gradients, glass effects, cartoon mascots, or invented activity to make the workspace feel busy.",
      "**Don't** turn every section into a promotional hero or add a kicker above its heading.",
      "**Don't** use color alone to communicate answer selection, a failure, or a destructive action.",
      "**Don't** hide missing provider configuration or imply that browser integrity signals prove misconduct."
    ]
  }
}
